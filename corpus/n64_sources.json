      "evaluation_policy": "dev_only"
    },
    {
      "id": "pokemonsnap",
      "url": "https://github.com/ethteck/pokemonsnap.git",
      "local_path": ".tools/corpus/pokemonsnap",
      "source_roots": ["src", "ultralib"],
      "evaluation_policy": "dev_only"
    },
    {
      "id": "dkr",
      "url": "https://github.com/davidsm64/diddy-kong-racing.git",
      "local_path": ".tools/corpus/dkr",
      "source_roots": ["src", "libultra"],
      "evaluation_policy": "dev_only"
    },
    {
      "id": "fzerox",
      "url": "https://github.com/inspectredc/fzerox.git",
