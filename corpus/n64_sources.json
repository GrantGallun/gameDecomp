    {
      "id": "sm64",
      "url": "https://github.com/n64decomp/sm64.git",
      "local_path": ".tools/corpus/sm64",
      "source_roots": ["src", "lib"],
      "evaluation_policy": "exclude_headline_famous"
    },
    {
      "id": "oot",
      "url": "https://github.com/zeldaret/oot.git",
      "local_path": ".tools/corpus/oot",
      "source_roots": ["src"],
